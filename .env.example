# Development Environment Configuration
# Copy this file to .env for local development

# Frontend API Configuration
NUXT_PUBLIC_OPERATIONS_API_BASE=http://localhost:5001
NUXT_PUBLIC_APP_MODE=online

# Database Configuration (for development)
POSTGRES_DB=frostlink
POSTGRES_USER=frostlink
POSTGRES_PASSWORD=frostlink-dev-password
DB_ANON_ROLE=anon
DB_SCHEMA=frostlink
TZ=Etc/UTC
DATABASE_PORT=5432

# API Configuration
OPS_API_PORT=5001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Docker Image Tags (for local build and push)
FRONTEND_TAG=latest
OPS_API_TAG=latest
