# Operations API Environment Configuration (Development)
# Copy this to operations-api/.env for local development

PORT=5001

# Database Configuration (for development)
OPS_DB_USER=frostlink
OPS_DB_PASSWORD=frostlink-dev-password
OPS_DB_HOST=localhost
OPS_DB_PORT=5432
OPS_DB_NAME=frostlink
DATABASE_URL=postgresql://frostlink:frostlink-dev-password@localhost:5432/frostlink

# Authentication & Security (REQUIRED - change in any deployed environment)
JWT_SECRET=your-secure-jwt-secret-dev-only-change-this
MOBILE_API_KEY=your-mobile-api-key-dev-only-change-this

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173