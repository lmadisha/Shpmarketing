{
  "name": "shpmarketing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:api": "npm --prefix apps/operations-api run dev",
    "dev:analytics": "npm --prefix apps/analytics-api run dev",
    "build": "npm --prefix apps/frontend run build",
    "generate": "npm --prefix apps/frontend run generate",
    "preview": "npm --prefix apps/frontend run preview",
    "typecheck": "npm --prefix apps/frontend run typecheck",
    "lint": "npm --prefix apps/frontend run lint",
    "lint:fix": "npm --prefix apps/frontend run lint:fix",
    "test": "npm --prefix apps/frontend run test",
    "test:watch": "npm --prefix apps/frontend run test:watch",
    "install:all": "cd apps/frontend && npm install && cd ../operations-api && npm install && cd ../analytics-api && npm install"
  }
}
